<div class="min-h-screen bg-[#08080f] text-[#e8e8f0] flex flex-col">

  <%= render "shared/header" %>

  <main class="flex-1 flex items-center justify-center px-6 py-16">
    <section class="w-full max-w-2xl">

      <div class="text-center mb-14">
        <h2 class="text-6xl font-semibold mb-4 tracking-tight">
          今日の<span class="text-[#a99df9]">気分</span>は？
        </h2>

        <p class="text-base text-[#8888a8]">
          曲調を選んで、ゲーム音楽を楽しもう。
        </p>
      </div>

      <div class="grid grid-cols-2 gap-5">

        <%= link_to player_path(mood_id: @mood.id),
          class: "
            flex flex-col items-center justify-center
            rounded-2xl p-10
            border border-[rgba(96,216,168,0.25)]
            bg-[rgba(96,216,168,0.08)]
            transition
            hover:scale-[1.02]
            active:scale-[0.98]
          " do %>
          <span class="text-5xl mb-4">
            🌿
          </span>

          <span class="text-xl font-semibold text-[#60d8a8]">
            落ち着いた
          </span>
        <% end %>

      </div>

    </section>
  </main>

  <%= render "shared/footer" %>

</div>